<UserControl x:Class="FractalLab.LSystems.LSystemPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="6">
            <WrapPanel Margin="0,0,0,6">
                <TextBlock Text="Пример:" VerticalAlignment="Center"/>
                <ComboBox x:Name="PresetCombo" Width="210" Margin="4,0,14,0"
                          SelectionChanged="PresetCombo_SelectionChanged"/>
                <Button Content="Открыть файл..." Click="OpenFileClick" Margin="0,0,14,0"/>
                <TextBlock Text="Итераций:" VerticalAlignment="Center"/>
                <TextBox x:Name="IterationsBox" Width="40" Margin="4,0,14,0" Text="4"/>
                <TextBlock Text="Случайность, %:" VerticalAlignment="Center"/>
                <TextBox x:Name="RandomBox" Width="40" Margin="4,0,14,0" Text="0"/>
                <Button Content="Построить" Click="BuildClick" Margin="0,0,14,0"/>
                <Button Content="Очистить" Click="ClearClick"/>
            </WrapPanel>
            <TextBlock Text="Описание L-системы (первая строка: атом, угол, начальное направление, рисующие символы; далее правила). Можно править прямо здесь:"
                       Margin="0,0,0,2"/>
            <TextBox x:Name="DescriptionBox" Height="96" AcceptsReturn="True"
                     FontFamily="Consolas" VerticalScrollBarVisibility="Auto"/>
        </StackPanel>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="6" Foreground="DarkGreen"/>
        <Canvas x:Name="DrawCanvas" Background="White" ClipToBounds="True"
                SizeChanged="DrawCanvas_SizeChanged"/>
    </DockPanel>
</UserControl>
