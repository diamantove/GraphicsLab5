<UserControl x:Class="FractalLab.LSystems.TreePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="6">
            <WrapPanel>
                <TextBlock Text="Вид:" VerticalAlignment="Center"/>
                <ComboBox x:Name="TreePresetCombo" Width="140" Margin="4,0,14,0"
                          SelectionChanged="TreePreset_SelectionChanged"/>
                <TextBlock Text="Угол ветвления:" VerticalAlignment="Center"/>
                <TextBox x:Name="AngleBox" Width="50" Margin="4,0,14,0" Text="22.5"/>
                <TextBlock Text="Итераций (1-6):" VerticalAlignment="Center"/>
                <TextBox x:Name="IterationsBox" Width="40" Margin="4,0,14,0" Text="5"/>
                <TextBlock Text="Случайность угла, %:" VerticalAlignment="Center"/>
                <TextBox x:Name="RandomBox" Width="40" Margin="4,0,14,0" Text="15"/>
                <Button Content="Нарисовать дерево" Click="DrawClick" Margin="0,0,14,0"/>
                <TextBlock Text="(каждое нажатие строит новое случайное дерево)"
                           VerticalAlignment="Center" Foreground="Gray"/>
            </WrapPanel>
        </StackPanel>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="6" Foreground="DarkGreen"/>
        <Canvas x:Name="DrawCanvas" Background="White" ClipToBounds="True"
                SizeChanged="DrawCanvas_SizeChanged"/>
    </DockPanel>
</UserControl>
